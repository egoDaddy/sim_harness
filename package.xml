<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_srunner</name>
  <version>0.1.0</version>
  <description>CARLA scenario_runner + Autoware e2e joint simulation orchestration (launcher, npc markers, lifecycle monitor, sensor fault injector)</description>
  <maintainer email="wangxuhua110@163.com">hcx</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>carla_ros_scenario_runner_types</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <!-- 故障注入接口 (FaultGroup.msg / ConfigureFault.srv) 在 ament_cmake 子包 -->
  <depend>autoware_srunner_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
